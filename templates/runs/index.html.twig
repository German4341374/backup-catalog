{% extends 'base.html.twig' %}{% set active = 'runs' %}
{% block title %}Backup Runs · Backup Catalog{% endblock %}
{% block content %}
<header class="page-header"><div><p class="eyebrow">Execution history</p><h1>Backup runs</h1><p>Registered results from backup platforms and operators.</p></div><div class="actions"><a class="button secondary" href="/backup-runs/export.csv">Export CSV</a><a class="button" href="/backup-runs/new">Register run</a></div></header>
<form class="filter-bar" method="get"><label><span>System</span><select name="systemId"><option value="0">All</option>{% for system in systems %}<option value="{{ system.id }}" {{ filters.systemId == system.id ? 'selected' : '' }}>{{ system.name }}</option>{% endfor %}</select></label><label><span>Status</span><select name="status"><option value="">All</option>{% for value in ['Running','Successful','Failed','Cancelled'] %}<option {{ filters.status == value ? 'selected' : '' }}>{{ value }}</option>{% endfor %}</select></label><label><span>Type</span><select name="type"><option value="">All</option>{% for value in ['Full','Incremental','Snapshot'] %}<option {{ filters.type == value ? 'selected' : '' }}>{{ value }}</option>{% endfor %}</select></label><button class="button secondary">Filter</button></form>
<section class="panel"><div class="panel-heading"><h2>{{ result.total }} recorded runs</h2><a href="/backup-runs/import">Import JSON</a></div><div class="table-wrap"><table><thead><tr><th>System</th><th>Job / type</th><th>Started</th><th>Duration</th><th>Status</th><th>Size</th><th>Storage</th></tr></thead><tbody>{% for run in result.items %}<tr><td><a class="primary-link" href="/systems/{{ run.system_id }}">{{ run.system_name }}</a></td><td>{{ run.job_name|default('-') }}<small>{{ run.backup_type }}</small></td><td>{{ run.started_at|utc_date }}</td><td>{{ duration(run.started_at, run.completed_at) }}</td><td><span class="badge badge-{{ run.status|lower }}">{{ run.status }}</span>{% if run.error_message %}<small class="error-text" title="{{ run.error_message }}">{{ run.error_message|slice(0, 45) }}</small>{% endif %}</td><td>{{ run.size_bytes|bytes }}</td><td><code>{{ run.storage_location }}</code></td></tr>{% else %}<tr><td colspan="7" class="empty">No runs match these filters.</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
