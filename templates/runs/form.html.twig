{% extends 'base.html.twig' %}{% set active = 'runs' %}
{% block title %}Register Backup Run · Backup Catalog{% endblock %}
{% block content %}
<header class="page-header"><div><p class="eyebrow">Manual entry</p><h1>Register backup run</h1><p>Record a result produced by an external backup process.</p></div></header>
<section class="panel form-panel"><form method="post" action="/backup-runs"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><div class="form-grid"><label><span>System</span><select required name="systemId"><option value="">Select a system</option>{% for system in systems %}<option value="{{ system.id }}">{{ system.name }}</option>{% endfor %}</select></label><label><span>Backup job</span><select name="backupJobId"><option value="">No linked job</option>{% for job in jobs %}<option value="{{ job.id }}">{{ job.system_name }} · {{ job.name }}</option>{% endfor %}</select></label><label><span>Type</span><select required name="type">{% for value in ['Full','Incremental','Snapshot'] %}<option>{{ value }}</option>{% endfor %}</select></label><label><span>Status</span><select required name="status">{% for value in ['Successful','Failed','Cancelled','Running'] %}<option>{{ value }}</option>{% endfor %}</select></label><label><span>Started at (UTC)</span><input required type="datetime-local" name="startedAt"></label><label><span>Completed at (UTC)</span><input type="datetime-local" name="completedAt"><small>Leave empty only for Running.</small></label><label><span>Size (bytes)</span><input type="number" min="0" name="sizeBytes"></label><label><span>External ID</span><input maxlength="160" name="externalId" placeholder="vendor-run-20260802-001"></label><label class="wide"><span>Storage location</span><input required maxlength="500" name="storageLocation" placeholder="s3://example-backups/customer-portal/ or vault://cluster-a/pool-1"></label><label class="wide"><span>Error message</span><textarea maxlength="2000" name="errorMessage" rows="3" placeholder="Only include operational error details; do not include secrets."></textarea></label></div><div class="form-actions"><a href="/backup-runs">Cancel</a><button class="button">Register result</button></div></form></section>
{% endblock %}
