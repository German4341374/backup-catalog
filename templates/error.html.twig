{% extends 'base.html.twig' %}
{% block title %}{{ status }} {{ title }} · Backup Catalog{% endblock %}
{% block content %}<section class="error-page"><p class="eyebrow">Request {{ requestId }}</p><h1>{{ status }} · {{ title }}</h1><p>{{ detail }}</p>{% if errors %}<ul>{% for field, message in errors %}<li><strong>{{ field }}</strong>: {{ message }}</li>{% endfor %}</ul>{% endif %}<a class="button" href="javascript:history.back()">Go back</a></section>{% endblock %}
