{% extends 'base.html.twig' %}{% set active = 'systems' %}
{% block title %}{{ system ? 'Edit system' : 'Add system' }} · Backup Catalog{% endblock %}
{% block content %}
<header class="page-header"><div><p class="eyebrow">System inventory</p><h1>{{ system ? 'Edit system' : 'Add protected system' }}</h1><p>Define the expected backup interval used by overdue detection.</p></div></header>
<section class="panel form-panel"><form method="post" action="{{ system ? '/systems/' ~ system.id : '/systems' }}"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><div class="form-grid"><label><span>System name</span><input required maxlength="120" name="name" value="{{ system.name|default('') }}" placeholder="Customer Portal"></label><label><span>Owner</span><input required maxlength="160" name="owner" value="{{ system.owner|default('') }}" placeholder="Digital Products Team"></label><label><span>Criticality</span><select required name="criticality">{% for value in ['Low','Medium','High','Critical'] %}<option {{ system and system.criticality == value ? 'selected' : '' }}>{{ value }}</option>{% endfor %}</select></label><label><span>Expected interval (hours)</span><input required type="number" min="1" max="8760" name="expectedBackupIntervalHours" value="{{ system.expected_backup_interval_hours|default(24) }}"></label></div><div class="form-actions"><a href="{{ system ? '/systems/' ~ system.id : '/systems' }}">Cancel</a><button class="button">{{ system ? 'Save changes' : 'Create system' }}</button></div></form></section>
{% endblock %}
