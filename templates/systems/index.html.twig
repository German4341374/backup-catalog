{% extends 'base.html.twig' %}{% set active = 'systems' %}
{% block title %}Systems · Backup Catalog{% endblock %}
{% block content %}
<header class="page-header"><div><p class="eyebrow">Inventory</p><h1>Protected systems</h1><p>Ownership, criticality, and expected backup freshness.</p></div><a class="button" href="/systems/new">Add system</a></header>
<form class="filter-bar" method="get"><label><span>Search</span><input name="query" value="{{ filters.query }}" placeholder="System or owner"></label><label><span>Criticality</span><select name="criticality"><option value="">All</option>{% for value in ['Low','Medium','High','Critical'] %}<option {{ filters.criticality == value ? 'selected' : '' }}>{{ value }}</option>{% endfor %}</select></label><label><span>Health</span><select name="health"><option value="">All</option>{% for value in ['Healthy','Overdue','Never backed up'] %}<option {{ filters.health == value ? 'selected' : '' }}>{{ value }}</option>{% endfor %}</select></label><button class="button secondary">Filter</button></form>
<section class="panel"><div class="panel-heading"><h2>{{ result.total }} systems</h2></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Owner</th><th>Criticality</th><th>Expected interval</th><th>Last success</th><th>Health</th></tr></thead><tbody>
{% for system in result.items %}<tr><td><a class="primary-link" href="/systems/{{ system.id }}">{{ system.name }}</a></td><td>{{ system.owner }}</td><td><span class="badge badge-{{ system.criticality|lower }}">{{ system.criticality }}</span></td><td>{{ system.expected_backup_interval_hours }}h</td><td>{{ system.last_successful_at|relative_time }}<small>{{ system.last_successful_size_bytes|bytes }}</small></td><td><span class="badge {{ system.health_status == 'Healthy' ? 'badge-success' : 'badge-danger' }}">{{ system.health_status }}</span></td></tr>{% else %}<tr><td colspan="6" class="empty">No systems match these filters.</td></tr>{% endfor %}
</tbody></table></div></section>
{% endblock %}
