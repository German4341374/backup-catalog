{% extends 'base.html.twig' %}{% set active = 'systems' %}
{% block title %}{{ system.name }} · Backup Catalog{% endblock %}
{% block content %}
<header class="page-header"><div><p class="eyebrow">System detail</p><h1>{{ system.name }}</h1><p>{{ system.owner }} · Expected every {{ system.expected_backup_interval_hours }} hours</p></div><div class="actions"><a class="button secondary" href="/systems/{{ system.id }}/edit">Edit</a><a class="button" href="/backup-runs/new?systemId={{ system.id }}">Register run</a></div></header>
<section class="metrics compact"><article><span>Health</span><strong class="text-{{ system.health_status == 'Healthy' ? 'success' : 'danger' }}">{{ system.health_status }}</strong></article><article><span>Criticality</span><strong>{{ system.criticality }}</strong></article><article><span>Last success</span><strong>{{ system.last_successful_at|relative_time }}</strong><small>{{ system.last_successful_at|utc_date }}</small></article><article><span>Last size</span><strong>{{ system.last_successful_size_bytes|bytes }}</strong></article></section>
<div class="grid half"><section class="panel"><div class="panel-heading"><h2>Backup jobs</h2></div>{% for job in jobs %}<div class="list-row"><div><strong>{{ job.name }}</strong><small>{{ job.schedule_description }}</small></div><div><span class="badge">{{ job.backup_type }}</span><small>{{ job.max_runtime_minutes }} min max</small></div></div>{% else %}<div class="empty">No backup jobs are configured.</div>{% endfor %}</section><section class="panel"><div class="panel-heading"><h2>Policy</h2></div><dl class="detail-list"><div><dt>Owner</dt><dd>{{ system.owner }}</dd></div><div><dt>Interval</dt><dd>{{ system.expected_backup_interval_hours }} hours</dd></div><div><dt>Next due</dt><dd>{{ system.next_backup_due_at|utc_date }}</dd></div><div><dt>Latest run</dt><dd>{{ system.last_run_status|default('-') }}</dd></div></dl></section></div>
<section class="panel"><div class="panel-heading"><h2>Recent runs</h2><a href="/backup-runs?systemId={{ system.id }}">View full history</a></div><div class="table-wrap"><table><thead><tr><th>Started</th><th>Job</th><th>Type</th><th>Status</th><th>Duration</th><th>Size</th></tr></thead><tbody>{% for run in runs %}<tr><td>{{ run.started_at|utc_date }}</td><td>{{ run.job_name|default('-') }}</td><td>{{ run.backup_type }}</td><td><span class="badge badge-{{ run.status|lower }}">{{ run.status }}</span></td><td>{{ duration(run.started_at, run.completed_at) }}</td><td>{{ run.size_bytes|bytes }}</td></tr>{% else %}<tr><td colspan="6" class="empty">No runs recorded.</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
